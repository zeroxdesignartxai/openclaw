{
  "name": "SiteLink Commander",
  "description": "Pair tabs, create command links, and run repeatable cross-site workflows.",
  "version": "1.0.0",
  "manifest_version": 3,
  "action": { "default_title": "SiteLink Commander" },
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "css": ["src/ui/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "optional_host_permissions": ["<all_urls>"],
  "options_page": "README.html"
}
