{
  "manifest_version": 3,
  "name": "Suno Pro Downloader",
  "description": "Bulk download manager exclusively for Suno Pro & Premier subscribers.",
  "version": "1.1.0",
  "permissions": [
    "storage",
    "downloads",
    "cookies",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.suno.com/*",
    "https://*.suno.ai/*",
    "https://app.suno.ai/*",
    "https://studio-api.suno.ai/*",
    "https://clerk.suno.ai/*",
    "https://clerk.suno.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://suno.com/*",
        "https://www.suno.com/*",
        "https://app.suno.ai/*",
        "https://www.suno.ai/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
